#!/bin/ash
set -eu

cd /usr/src/app
redis-server --bind 127.0.0.1 --save "" --appendonly no --daemonize yes --logfile /tmp/redis.log
bundle exec rails db:prepare:with_data >/tmp/thumbnails-test-db.log 2>&1 || {
  cat /tmp/thumbnails-test-db.log
  exit 1
}
bundle exec ruby /plugins/manyfold_thumbnails/test/support/check_worker_startup.rb
bundle exec ruby /plugins/manyfold_thumbnails/test/support/check_migration_upgrade.rb
mkdir -p /tmp/thumbnails-no-plugins
PLUGINS_PATH=/tmp/thumbnails-no-plugins \
  bundle exec rails runner /plugins/manyfold_thumbnails/test/support/plugin_removal.rb
exec bundle exec rails runner /plugins/manyfold_thumbnails/test/plugin_test.rb
