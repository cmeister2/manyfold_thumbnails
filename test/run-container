#!/usr/bin/env sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
source_root=$(CDPATH= cd -- "$1" && pwd)
expected_version=${2:-}

set -- docker run --rm --pull=missing --network none \
  --entrypoint /plugins/manyfold_thumbnails/test/run \
  --mount "type=bind,source=$source_root,target=/plugins/manyfold_thumbnails,readonly" \
  --mount "type=bind,source=$plugin_root/test,target=/plugins/manyfold_thumbnails/test,readonly" \
  --mount "type=bind,source=$plugin_root/test/vendor/catwalk,target=/test-catwalk,readonly" \
  --tmpfs /config:exec \
  --env MANYFOLD_THUMBNAILS_CATWALK_CACHE=/config/catwalk \
  --env PLUGINS_PATH=/plugins \
  --env DATABASE_URL=sqlite3:/config/manyfold.sqlite3 \
  --env REDIS_URL=redis://127.0.0.1:6379/1 \
  --env MULTIUSER=enabled \
  --env MANYFOLD_LOG_LEVEL=warn \
  --env SECRET_KEY_BASE=manyfold-thumbnails-disposable-local-test-secret-with-no-real-data \
  --env MANYFOLD_THUMBNAILS_TEST=1 \
  --env "MANYFOLD_THUMBNAILS_EXPECTED_VERSION=$expected_version"

exec "$@" "${MANYFOLD_IMAGE:-manyfold3d/manyfold-solo:0.153.0@sha256:161109b917a158b5efd8478a437e9900db7bdc57235c167aa70d5ad69425fc31}"
