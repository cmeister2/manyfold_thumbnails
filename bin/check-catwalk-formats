#!/usr/bin/env python3
"""Check the pinned Catwalk's reader extensions against the plugin registry."""
import argparse
import json
from pathlib import Path
import platform
import re
import subprocess


def parse_catwalk_formats(output, expected_version):
    try:
        catalog = json.loads(output)
    except json.JSONDecodeError as error:
        raise ValueError(f"Malformed Catwalk --list-formats --json output: {error}") from error
    if not isinstance(catalog, dict):
        raise ValueError("Expected a Catwalk format catalog object.")
    schema = catalog.get("schema_version")
    if type(schema) is not int or schema != 1:
        raise ValueError(f"Unsupported Catwalk format catalog schema_version: {schema!r}")
    version = catalog.get("catwalk_version")
    if version != expected_version:
        raise ValueError(f"Catwalk format catalog version {version!r} does not match pinned version {expected_version!r}.")
    # Schema 1's extensions is the complete union of all reader aliases. Other
    # fields contain display descriptions and overlapping reader categories.
    extensions = catalog.get("extensions")
    if not isinstance(extensions, list) or any(
        not isinstance(extension, str) or not re.fullmatch(r"[a-z0-9]+", extension)
        for extension in extensions
    ):
        raise ValueError("Invalid Catwalk format catalog extensions; expected lowercase extensions without dots.")
    if extensions != sorted(set(extensions)):
        raise ValueError("Catwalk format catalog extensions must be sorted and unique.")
    return set(extensions)


def read_registry(path):
    source = path.read_text(encoding="utf-8")
    registry = []
    for constant in ("CATWALK_EXTENSIONS", "CATWALK_EXCLUDED_EXTENSIONS"):
        matches = re.findall(rf"\b{constant}\s*=\s*%w\[(.*?)\]", source, re.DOTALL)
        if len(matches) != 1:
            raise ValueError(f"Expected one {constant} list in {path}")
        values = matches[0].split()
        if not values or any(not re.fullmatch(r"[a-z0-9]+", value) for value in values):
            raise ValueError(f"Invalid extensions in {constant} in {path}")
        if len(values) != len(set(values)):
            raise ValueError(f"Duplicate extensions in {constant} in {path}")
        registry.append(set(values))
    return registry


def check_formats(upstream, supported, excluded):
    differences = {
        "Registered and excluded": supported & excluded,
        "Unreviewed Catwalk extensions": upstream - supported - excluded,
        "Registered extensions absent from Catwalk": supported - upstream,
        "Excluded extensions absent from Catwalk": excluded - upstream,
    }
    errors = [f"  {label}: {', '.join(sorted(values))}" for label, values in differences.items() if values]
    if errors:
        raise ValueError(
            "Catwalk format coverage differs from lib/manyfold_thumbnails/formats.rb:\n"
            + "\n".join(errors)
            + "\nReview CATWALK_EXTENSIONS and CATWALK_EXCLUDED_EXTENSIONS, including the plugin's format exclusions."
        )


def host_binary(root):
    machine = platform.machine().lower()
    architectures = {"x86_64": "x86_64", "amd64": "x86_64", "aarch64": "aarch64", "arm64": "aarch64"}
    if platform.system() != "Linux" or machine not in architectures:
        raise ValueError("No pinned Linux Catwalk binary for this host; supply --binary explicitly.")
    return root / "test/vendor/catwalk" / f"{architectures[machine]}-unknown-linux-musl" / "catwalk"


def catwalk_extensions(binary, expected_version):
    try:
        result = subprocess.run([str(binary), "--list-formats", "--json"], check=True, capture_output=True, text=True, timeout=30)
    except subprocess.CalledProcessError as error:
        raise ValueError(f"Catwalk --list-formats --json failed (exit {error.returncode}): {error.stderr.strip()}") from error
    return parse_catwalk_formats(result.stdout, expected_version)


def main():
    root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", type=Path, help="Use this executable instead of the verified host test asset.")
    args = parser.parse_args()
    binary = args.binary if args.binary is not None else host_binary(root)
    version = json.loads((root / "config/catwalk.json").read_text(encoding="utf-8"))["version"]
    supported, excluded = read_registry(root / "lib/manyfold_thumbnails/formats.rb")
    check_formats(catwalk_extensions(binary, version), supported, excluded)
    print(f"Catwalk format coverage verified ({len(supported)} registered, {len(excluded)} excluded extensions).")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        raise SystemExit(str(error))
