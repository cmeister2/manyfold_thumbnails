#!/usr/bin/env python3
"""Download and verify the pinned static Linux Catwalk release for plugin ZIPs."""
import argparse
import hashlib
import io
import json
from pathlib import Path
import shutil
import tempfile
import time
import urllib.error
import urllib.request
import zipfile


def digest(path):
    checksum = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            checksum.update(block)
    return checksum.hexdigest()


def check_target(directory, target, release, version):
    for name, expected in release["files"].items():
        path = directory / name
        if not path.is_file() or path.is_symlink() or digest(path) != expected:
            raise ValueError(f"Missing or unverified Catwalk asset: {path}")
    metadata = json.loads((directory / "release.json").read_text(encoding="utf-8"))
    if metadata.get("version") != version or metadata.get("target") != target or metadata.get("binary") != "catwalk":
        raise ValueError(f"Unexpected Catwalk release metadata: {directory / 'release.json'}")
    if not (directory / "catwalk").stat().st_mode & 0o111:
        raise ValueError(f"Catwalk binary is not executable: {directory / 'catwalk'}")


def download(url):
    request = urllib.request.Request(url, headers={"User-Agent": "manyfold-thumbnails-vendor"})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                return response.read()
        except (urllib.error.URLError, TimeoutError):
            if attempt == 2:
                raise
            time.sleep(attempt + 1)


def main():
    root = Path(__file__).resolve().parents[1]
    metadata = json.loads((root / "config/catwalk.json").read_text(encoding="utf-8"))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Check existing files without network access.")
    parser.add_argument("--target", action="append", choices=metadata["targets"], help="Vendor a single target; defaults to both Linux architectures.")
    args = parser.parse_args()
    vendor = root / "lib/manyfold_thumbnails/vendor"
    for target in args.target or metadata["targets"]:
        release = metadata["targets"][target]
        destination = vendor / target
        try:
            check_target(destination, target, release, metadata["version"])
        except ValueError:
            if args.check:
                raise
        else:
            print(f"Verified Catwalk {metadata['version']} ({target}).")
            continue

        print(f"Downloading Catwalk {metadata['version']} ({target}).", flush=True)
        data = download(release["url"])
        if hashlib.sha256(data).hexdigest() != release["sha256"]:
            raise ValueError(f"Catwalk archive checksum mismatch: {release['url']}")
        vendor.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".catwalk-", dir=vendor) as temporary:
            extracted = Path(temporary)
            prefix = f"catwalk3d-{metadata['version']}-{target}/"
            with zipfile.ZipFile(io.BytesIO(data)) as archive:
                expected_names = {prefix + name for name in release["files"]}
                if set(archive.namelist()) != expected_names:
                    raise ValueError("Unexpected files in Catwalk release archive.")
                for name in release["files"]:
                    (extracted / name).write_bytes(archive.read(prefix + name))
                    (extracted / name).chmod(0o755 if name == "catwalk" else 0o644)
            check_target(extracted, target, release, metadata["version"])
            if destination.exists():
                shutil.rmtree(destination)
            extracted.rename(destination)
        print(f"Verified Catwalk {metadata['version']} ({target}).")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, zipfile.BadZipFile) as error:
        raise SystemExit(f"{error}\nRun bin/vendor-catwalk to install the pinned release assets.")
