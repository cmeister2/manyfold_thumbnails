#!/usr/bin/env python3
"""Fetch hash-pinned public SolidWorks qualification assets outside the plugin."""
import hashlib
import json
from pathlib import Path
import struct
import urllib.request
import urllib.parse

ROOT = Path(__file__).resolve().parent.parent
METADATA = ROOT / "test/fixtures/native_geometry/solidworks/qualification.json"
DESTINATION = ROOT / "test/vendor/catwalk/solidworks"


def without_previews(original):
    # This is a transform of one hash-qualified fixture, not a general CAD reader.
    # Preserve the entire container except the two regular-FAT preview streams.
    data = bytearray(original)
    assert data[:8] == bytes.fromhex("d0cf11e0a1b11ae1")
    sector_size = 1 << struct.unpack_from("<H", data, 30)[0]
    assert sector_size == 512
    fat_count, directory_start = struct.unpack_from("<II", data, 44)
    fat_ids = struct.unpack_from("<109I", data, 76)[:fat_count]
    assert fat_count <= 109

    def sector(index):
        start = (index + 1) * sector_size
        assert start + sector_size <= len(data)
        return data[start:start + sector_size]

    fat = []
    for index in fat_ids:
        fat.extend(struct.unpack("<128I", sector(index)))

    def chain(start):
        visited = set()
        while start != 0xFFFFFFFE:
            assert start not in visited and start < len(fat)
            visited.add(start)
            yield start
            start = fat[start]

    directory = b"".join(sector(index) for index in chain(directory_start))
    replaced = set()
    for offset in range(0, len(directory), 128):
        entry = directory[offset:offset + 128]
        length = struct.unpack_from("<H", entry, 64)[0]
        if entry[66] != 2 or length < 2:
            continue
        name = entry[:length - 2].decode("utf-16le")
        if name not in ("Preview", "PreviewPNG"):
            continue
        start, size = struct.unpack_from("<IQ", entry, 116)
        assert size >= 4096  # These pinned previews never use the miniFAT.
        for index in chain(start):
            count = min(size, sector_size)
            position = (index + 1) * sector_size
            data[position:position + count] = b"\0" * count
            size -= count
        assert size == 0
        replaced.add(name)
    assert replaced == {"Preview", "PreviewPNG"}
    return bytes(data)


def main():
    metadata = json.loads(METADATA.read_text())
    DESTINATION.mkdir(parents=True, exist_ok=True)
    prefix = ("https://raw.githubusercontent.com/cmeister2/catwalk3d/" +
              metadata["catwalk_revision"] + "/tests/fixtures/formats/solidworks/")
    for record in metadata["files"]:
        target = DESTINATION / record["file"]
        if target.exists() and hashlib.sha256(target.read_bytes()).hexdigest() == record["sha256"]:
            continue
        if record["file"] == "no-preview.sldasm":
            source = without_previews((DESTINATION / "solidworks-powerpackage.sldasm").read_bytes())
        else:
            with urllib.request.urlopen(prefix + urllib.parse.quote(record["file"]), timeout=60) as response:
                source = response.read(4 * 1024 * 1024 + 1)
        if hashlib.sha256(source).hexdigest() != record["sha256"]:
            raise ValueError("SolidWorks fixture hash mismatch: " + record["file"])
        target.write_bytes(source)
    print("Verified public SolidWorks assembly qualification fixtures.")


if __name__ == "__main__":
    main()
